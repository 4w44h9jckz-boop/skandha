{
  "name": "@skandha/framepool",
  "private": true,
  "version": "4.0.2",
  "description": "EIP-8141 frame transaction pool rules, a second implementation of emem's specification checked by its conformance vectors",
  "author": "Etherspot",
  "homepage": "https://github.com/etherspot/skandha#readme",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*.d.ts",
    "lib/**/*.js",
    "lib/**/*.js.map",
    "*.d.ts",
    "*.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/etherspot/skandha.git"
  },
  "scripts": {
    "clean": "rm -rf lib && rm -f *.tsbuildinfo",
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --color --ext .ts src/ test/",
    "test": "bun run test:unit",
    "test:unit": "vitest --run --dir test/unit/",
    "vectors": "bun test/run-vectors.ts"
  }
}
