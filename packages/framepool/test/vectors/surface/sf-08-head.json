{
 "clause": "SF-8",
 "also": [
  "MD-8",
  "FP-15",
  "SF-4"
 ],
 "document": "11-surface.md",
 "version": 1,
 "operation": "surface",
 "distinguishes": "At a new head the node asks the client about every transaction still pending, reads the state its dependencies name, and resets the pool with both, so that a changed verdict removes a transaction and an included one leaves without being asked about.",
 "cases": [
  {
   "name": "every pending transaction is asked about, and nothing changed re-runs nothing",
   "profile": "hegota-testnet",
   "state": {
    "0xa6b01af7512a08b1f0a7603765b21a53a7d1d7db": {
     "nonce": 9,
     "balance": 1000000000000000000
    },
    "0xa7aff3568865020aa95d4ee82eee7c4d7ec01a5c": {
     "balance": 1000000000000000000
    }
   },
   "steps": [
    {
     "rpc": "",
     "as": "t1",
     "client": {
      "valid": true
     },
     "expect": {
      "result": "ok"
     }
    },
    {
     "rpc": "",
     "as": "t3",
     "client": {
      "valid": true
     },
     "expect": {
      "result": "ok",
      "hash": "0x26ed3e31ef89ea6f6713dafb34e952ca510bb30634d3e8c0ebc5abc9dadc12a3"
     }
    },
    {
     "head": {
      "number": 1,
      "timestamp": 1012
     },
     "client": {
      "t1": {
       "valid": true
      },
      "t3": {
       "valid": true
      }
     },
     "expect_asked": [
      "t1",
      "t3"
     ],
     "expect_resimulated": [],
     "expect_pending": [
      "t1",
      "t3"
     ]
    }
   ],
   "derivation": "SF-8 step 2 asks about both; their verdicts and the balances, codes and sequences step 1 reads are unchanged, so FP-15 re-runs neither."
  },
  {
   "name": "a different verdict at the new head removes the transaction",
   "profile": "hegota-testnet",
   "state": {
    "0xa6b01af7512a08b1f0a7603765b21a53a7d1d7db": {
     "nonce": 9,
     "balance": 1000000000000000000
    },
    "0xa7aff3568865020aa95d4ee82eee7c4d7ec01a5c": {
     "balance": 1000000000000000000
    }
   },
   "steps": [
    {
     "rpc": "",
     "as": "t1",
     "client": {
      "valid": true
     },
     "expect": {
      "result": "ok"
     }
    },
    {
     "rpc": "",
     "as": "t3",
     "client": {
      "valid": true
     },
     "expect": {
      "result": "ok"
     }
    },
    {
     "head": {
      "number": 1,
      "timestamp": 1012
     },
     "client": {
      "t1": {
       "valid": false,
       "violation": "validation prefix frame reverted"
      },
      "t3": {
       "valid": true
      }
     },
     "expect_asked": [
      "t1",
      "t3"
     ],
     "expect_resimulated": [
      "t1"
     ],
     "expect_pending": [
      "t3"
     ]
    }
   ],
   "derivation": "t1's verdict at the new head differs from the one recorded, which FP-15 step 3 counts as a changed dependency; re-run with it, t1 is refused."
  },
  {
   "name": "an included transaction is not asked about and leaves without a re-run",
   "profile": "hegota-testnet",
   "state": {
    "0xa6b01af7512a08b1f0a7603765b21a53a7d1d7db": {
     "nonce": 9,
     "balance": 1000000000000000000
    },
    "0xa7aff3568865020aa95d4ee82eee7c4d7ec01a5c": {
     "balance": 1000000000000000000
    }
   },
   "steps": [
    {
     "rpc": "",
     "as": "t1",
     "client": {
      "valid": true
     },
     "expect": {
      "result": "ok"
     }
    },
    {
     "rpc": "",
     "as": "t3",
     "client": {
      "valid": true
     },
     "expect": {
      "result": "ok"
     }
    },
    {
     "head": {
      "number": 1,
      "timestamp": 1012
     },
     "state": {
      "0xa6b01af7512a08b1f0a7603765b21a53a7d1d7db": {
       "nonce": 10
      }
     },
     "client": {
      "t3": {
       "valid": true
      }
     },
     "expect_asked": [
      "t3"
     ],
     "expect_resimulated": [],
     "expect_pending": [
      "t3"
     ]
    }
   ],
   "derivation": "Step 1 reads t1's sender at sequence 10, above its 9, so step 2 does not ask about it, and FP-15 step 1 removes it as included."
  }
 ]
