{
 "clause": "SF-9",
 "also": [
  "SF-5",
  "SF-7"
 ],
 "document": "11-surface.md",
 "version": 2,
 "operation": "surface",
 "distinguishes": "A node with handoff true sends its client exactly what its pool admits, from JSON-RPC or from a peer, and a node with handoff false sends nothing.",
 "cases": [
  {
   "name": "handoff true: what is admitted is handed on, and nothing else",
   "profile": "hegota-testnet",
   "config": {
    "surface": {
     "handoff": true
    }
   },
   "state": {
    "0xa6b01af7512a08b1f0a7603765b21a53a7d1d7db": {
     "nonce": 9,
     "balance": 1000000000000000000
    },
    "0xa7aff3568865020aa95d4ee82eee7c4d7ec01a5c": {
     "balance": 1000000000000000000
    }
   },
   "peers": [
    "p1"
   ],
   "steps": [
    {
     "rpc": "",
     "client": {
      "valid": true
     },
     "expect": {
      "result": "ok",
      "handed": true
     }
    },
    {
     "rpc": "",
     "client": {
      "valid": true
     },
     "expect": {
      "result": "ErrAlreadyKnown",
      "handed": false
     }
    },
    {
     "peer": "",
     "from": "p1",
     "client": {
      "valid": false,
      "violation": "StorageReadNonSender"
     },
     "expect": {
      "result": "ErrFrameStorageReadNonSender",
      "handed": false
     }
    },
    {
     "peer": "",
     "from": "p1",
     "client": {
      "valid": true
     },
     "expect": {
      "result": "ok",
      "handed": true
     }
    }
   ],
   "derivation": "SF-9: every transaction the pool admits, and only those, whichever way it came."
  },
  {
   "name": "handoff false: nothing is handed on",
   "profile": "hegota-testnet",
   "state": {
    "0xa6b01af7512a08b1f0a7603765b21a53a7d1d7db": {
     "nonce": 9,
     "balance": 1000000000000000000
    }
   },
   "peers": [
    "p1"
   ],
   "steps": [
    {
     "rpc": "",
     "client": {
      "valid": true
     },
     "expect": {
      "result": "ok",
      "handed": false,
      "relay_to": [
       "p1"
      ]
     }
    }
   ],
   "derivation": "SF-1: handoff is false in both profiles; the node still relays (SF-6)."
  }
 ]
}
