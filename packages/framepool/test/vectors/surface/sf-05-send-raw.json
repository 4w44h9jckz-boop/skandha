 "distinguishes": "eth_sendRawTransaction answers the chain's hash for what the pool admits and relays it, answers a refusal as an error carrying its code and relays nothing, and asks the client only about a transaction that SF-2 and FP-2 to FP-7 let through.",
 "cases": [
  {
   "name": "an admitted transaction answers its hash and goes to every peer; sent again it is known",
   "profile": "hegota-testnet",
   "state": {
    "0xa6b01af7512a08b1f0a7603765b21a53a7d1d7db": {
     "nonce": 9,
     "balance": 1000000000000000000
    }
   },
   "peers": [
    "p1",
    "p2"
   ],
   "steps": [
    {
     "rpc": "",
     "client": {
      "valid": true
     },
     "expect": {
      "result": "ok",
      "hash": "0x045fb58b1c52183b3869d764ac5deebf697dd835d9cacfe2ef54b8283a24f723",
      "asked_client": true,
      "relay_to": [
       "p1",
       "p2"
      ]
     }
    },
    {
     "rpc": "",
     "client": {
      "valid": true
     },
     "expect": {
      "result": "ErrAlreadyKnown",
      "error_code": -32000,
      "asked_client": false,
      "relay_to": []
     }
    }
   ],
   "derivation": "The transaction mined as 0x045fb58b1c52183b3869d764ac5deebf697dd835d9cacfe2ef54b8283a24f723 passes FP-2 to FP-7 with its sender at sequence 9, the client answers valid, FP-8's payment check passes against 10^18, so add answers ok and SF-5 returns keccak256 of the bytes. The same bytes again are FP-2's duplicate, refused before the client is asked."
  },
