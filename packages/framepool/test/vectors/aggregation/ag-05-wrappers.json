          {"label": "B", "type": 6, "sender": "bob", "frames": [{"mode": 3, "deps": [[16, "msg-b", "pk-b"]], "exec_gas": 3000, "data_size": 96}, {"mode": 1, "flags": 3}]}],
          "deps": [[16, "msg-b", "pk-b"], [17, "pub-a", "vk-1"]], "proofs": [true, false]},
        "expect": "ErrWrapperProof"},
       {"expect_pool": {"pending": {}}}
     ]},
    {"name": "the limits are checked before the proofs", "profile": "eip-8288",
     "state": {"alice": {"balance": 1000000000}, "carol": {"balance": 1000000000}},
     "steps": [
       {"wrapper": {"mode": 0, "txs": [
          {"label": "A", "type": 6, "sender": "alice", "frames": [{"mode": 3, "deps": [[17, "pub-a", "vk-1"]], "exec_gas": 30000, "data_size": 96}, {"mode": 1, "flags": 3}]},
          {"label": "C", "type": 6, "sender": "carol", "frames": [{"mode": 3, "deps": [[17, "pub-c", "vk-1"]], "exec_gas": 30000, "data_size": 96}, {"mode": 1, "flags": 3}]}],
          "deps": [[17, "pub-a", "vk-1"], [17, "pub-c", "vk-1"]], "proofs": [false, false]},
        "expect": "ErrWrapperTooManyDeps"}
     ]},
    {"name": "mode 1 whose STARK proves its deps", "profile": "eip-8288",
