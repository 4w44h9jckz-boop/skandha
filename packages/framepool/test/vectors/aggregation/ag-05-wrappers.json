     "state": {"bob": {"balance": 1000000000}, "dave": {"balance": 1000000000}},
     "steps": [
       {"wrapper": {"mode": 0, "txs": [
          {"label": "B", "type": 6, "sender": "bob", "frames": [{"mode": 3, "deps": [[16, "msg-b", "pk-b"]], "exec_gas": 3000, "data_size": 96}, {"mode": 1, "flags": 3}]},
          {"label": "D", "type": 6, "sender": "dave", "frames": [{"mode": 3, "deps": [[16, "msg-d", "pk-d"]], "exec_gas": 3000, "data_size": 96}, {"mode": 1, "flags": 3}]}],
          "deps": [[16, "msg-b", "pk-b"], [16, "msg-d", "pk-d"]], "proofs": [true, true]},
        "expect": "ErrWrapperTooManyDeps"}
     ]},
    {"name": "mode 0 is limited even when aggregates are not", "profile": "eip-8288", "config": {"frame": {"cap_aggregates": false}},
