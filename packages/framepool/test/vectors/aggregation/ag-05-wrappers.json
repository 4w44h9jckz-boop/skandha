          {"hash": {"label": "B", "type": 6, "sender": "bob", "frames": [{"mode": 3, "deps": [[16, "msg-b", "pk-b"]], "exec_gas": 3000, "data_size": 96}, {"mode": 1, "flags": 3}]}},
