     "steps": [
       {"wrapper": {"mode": 1, "from": "peer-1", "txs": [
          {"label": "A", "type": 6, "sender": "alice", "frames": [{"mode": 3, "deps": [[17, "pub-a", "vk-1"]], "exec_gas": 30000, "data_size": 96}, {"mode": 1, "flags": 3}]},
          {"label": "B", "type": 6, "sender": "bob", "frames": [{"mode": 3, "deps": [[16, "msg-b", "pk-b"]], "exec_gas": 3000, "data_size": 96}, {"mode": 1, "flags": 3}]}],
          "deps": [[16, "msg-b", "pk-b"], [17, "pub-a", "vk-1"]],
          "stark": {"covers": [[16, "msg-b", "pk-b"], [17, "pub-a", "vk-1"]], "valid": true}},
        "expect": ["ok", "ok"]}
     ]},
    {"name": "mode 1 whose STARK's public input is another list", "profile": "eip-8288",
     "state": {"alice": {"balance": 1000000000}, "bob": {"balance": 1000000000}},
     "steps": [
       {"wrapper": {"mode": 1, "from": "peer-1", "txs": [
          {"label": "A", "type": 6, "sender": "alice", "frames": [{"mode": 3, "deps": [[17, "pub-a", "vk-1"]], "exec_gas": 30000, "data_size": 96}, {"mode": 1, "flags": 3}]},
          {"label": "B", "type": 6, "sender": "bob", "frames": [{"mode": 3, "deps": [[16, "msg-b", "pk-b"]], "exec_gas": 3000, "data_size": 96}, {"mode": 1, "flags": 3}]}],
          "deps": [[16, "msg-b", "pk-b"], [17, "pub-a", "vk-1"]],
