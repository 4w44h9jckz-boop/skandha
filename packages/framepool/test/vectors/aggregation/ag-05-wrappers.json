          {"label": "A", "type": 6, "sender": "alice", "frames": [{"mode": 3, "deps": [[17, "pub-a", "vk-1"]], "exec_gas": 30000, "data_size": 96}, {"mode": 1, "flags": 3}]},
          {"label": "C", "type": 6, "sender": "carol", "frames": [{"mode": 3, "deps": [[17, "pub-c", "vk-1"]], "exec_gas": 30000, "data_size": 96}, {"mode": 1, "flags": 3}]}],
          "deps": [[17, "pub-a", "vk-1"], [17, "pub-c", "vk-1"]], "proofs": [true, true]},
        "expect": "ErrWrapperTooManyDeps"}
