          "deps": [[16, "msg-b", "pk-b"]], "proofs": [true]},
        "expect": ["ok"]},
       {"wrapper": {"mode": 0, "txs": [
          {"hash": {"label": "B", "type": 6, "sender": "bob", "frames": [{"mode": 3, "deps": [[16, "msg-b", "pk-b"]], "exec_gas": 3000, "data_size": 96}, {"mode": 1, "flags": 3}]}},
          {"label": "A", "type": 6, "sender": "alice", "frames": [{"mode": 3, "deps": [[17, "pub-a", "vk-1"]], "exec_gas": 30000, "data_size": 96}, {"mode": 1, "flags": 3}]}],
          "deps": [[16, "msg-b", "pk-b"], [17, "pub-a", "vk-1"]], "proofs": [true, true]},
        "expect": ["ErrAlreadyKnown", "ok"]}
     ]},
