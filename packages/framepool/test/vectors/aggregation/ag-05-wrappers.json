{
  "clause": "AG-5",
  "document": "05-aggregation.md",
  "version": 3,
  "also": ["AG-6"],
  "operation": "pool",
  "distinguishes": "The checks on a wrapper, in their order: its mode and proof count, hashes a mode 0 wrapper cannot resolve, its deps against its transactions or its STARK's public input, the limits, then the proofs. Whether the limits bind a mode 1 wrapper is cap_aggregates, an Interpretation (decision record 0012).",
  "cases": [
    {"name": "mode 0 with its deps and valid proofs", "profile": "eip-8288",
     "state": {"alice": {"balance": 1000000000}, "bob": {"balance": 1000000000}},
     "steps": [
       {"wrapper": {"mode": 0, "txs": [
          {"label": "A", "type": 6, "sender": "alice", "frames": [{"mode": 3, "deps": [[17, "pub-a", "vk-1"]], "exec_gas": 30000, "data_size": 96}, {"mode": 1, "flags": 3}]},
          {"label": "B", "type": 6, "sender": "bob", "frames": [{"mode": 3, "deps": [[16, "msg-b", "pk-b"]], "exec_gas": 3000, "data_size": 96}, {"mode": 1, "flags": 3}]}],
          "deps": [[16, "msg-b", "pk-b"], [17, "pub-a", "vk-1"]], "proofs": [true, true]},
        "expect": ["ok", "ok"]},
       {"expect_pool": {"pending": {"alice": ["A"], "bob": ["B"]}}}
     ]},
    {"name": "a mode other than 0 and 1", "profile": "eip-8288",
     "state": {"alice": {"balance": 1000000000}},
     "steps": [
       {"wrapper": {"mode": 2, "txs": [
          {"label": "A", "type": 6, "sender": "alice", "frames": [{"mode": 3, "deps": [[17, "pub-a", "vk-1"]], "exec_gas": 30000, "data_size": 96}, {"mode": 1, "flags": 3}]}],
          "deps": [[17, "pub-a", "vk-1"]], "proofs": [true]},
        "expect": "ErrWrapperMalformed"},
       {"expect_pool": {"pending": {}}}
     ]},
    {"name": "mode 0 with fewer proofs than deps", "profile": "eip-8288",
     "state": {"alice": {"balance": 1000000000}, "bob": {"balance": 1000000000}},
     "steps": [
       {"wrapper": {"mode": 0, "txs": [
          {"label": "A", "type": 6, "sender": "alice", "frames": [{"mode": 3, "deps": [[17, "pub-a", "vk-1"]], "exec_gas": 30000, "data_size": 96}, {"mode": 1, "flags": 3}]},
          {"label": "B", "type": 6, "sender": "bob", "frames": [{"mode": 3, "deps": [[16, "msg-b", "pk-b"]], "exec_gas": 3000, "data_size": 96}, {"mode": 1, "flags": 3}]}],
          "deps": [[16, "msg-b", "pk-b"], [17, "pub-a", "vk-1"]], "proofs": [true]},
        "expect": "ErrWrapperMalformed"}
     ]},
    {"name": "mode 0 naming by hash a transaction the node does not hold", "profile": "eip-8288",
     "state": {"alice": {"balance": 1000000000}, "bob": {"balance": 1000000000}},
     "steps": [
       {"wrapper": {"mode": 0, "txs": [
          {"hash": {"label": "B", "type": 6, "sender": "bob", "frames": [{"mode": 3, "deps": [[16, "msg-b", "pk-b"]], "exec_gas": 3000, "data_size": 96}, {"mode": 1, "flags": 3}]}},
          {"label": "A", "type": 6, "sender": "alice", "frames": [{"mode": 3, "deps": [[17, "pub-a", "vk-1"]], "exec_gas": 30000, "data_size": 96}, {"mode": 1, "flags": 3}]}],
          "deps": [[16, "msg-b", "pk-b"], [17, "pub-a", "vk-1"]], "proofs": [true, true]},
        "expect": "ErrWrapperUnknownTx"},
       {"expect_pool": {"pending": {}}}
     ]},
    {"name": "mode 0 naming by hash a transaction the node holds", "profile": "eip-8288",
