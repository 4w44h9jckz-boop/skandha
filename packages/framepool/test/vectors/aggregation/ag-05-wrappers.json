    {"name": "mode 1 over the leanSTARK limit when aggregates are not limited", "profile": "eip-8288", "config": {"frame": {"cap_aggregates": false}},
     "state": {"alice": {"balance": 1000000000}, "carol": {"balance": 1000000000}},
     "steps": [
       {"wrapper": {"mode": 1, "from": "peer-1", "txs": [
