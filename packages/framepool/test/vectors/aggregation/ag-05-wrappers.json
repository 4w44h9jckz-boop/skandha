          "deps": [[17, "pub-a", "vk-1"], [17, "pub-a", "vk-1"]], "proofs": [true, true]},
        "expect": "ErrWrapperDeps"}
     ]},
    {"name": "mode 0 over the leanSTARK limit", "profile": "eip-8288",
