{
 "clause": "AG-7",
 "also": [
  "AG-5"
 ],
 "document": "05-aggregation.md",
 "version": 4,
 "operation": "pool",
 "distinguishes": "Under eip-8288-master a node folds the leanSPHINCS dependencies it holds into one mode 1 wrapper, at most max_sig_deps_per_wrapper of them, and accepts another node's fold over the same dependencies; an implementation that cannot build the fold, or refuses an equal one, fails here.",
 "cases": [
  {
   "name": "two signatures, one fold",
   "profile": "eip-8288-master",
   "state": {
    "alice": {
     "balance": 1000000000
    },
    "bob": {
     "balance": 1000000000
    },
    "carol": {
     "balance": 1000000000
    }
   },
   "steps": [
    {
     "wrapper": {
      "mode": 0,
      "txs": [
       {
        "label": "A",
        "type": 6,
        "sender": "alice",
        "frames": [
         {
          "mode": 4,
          "deps": [
           [
            16,
            "msg-A-0",
            "pk-alice"
           ]
          ],
          "exec_gas": 3000,
          "data_size": 96
         },
         {
          "mode": 1,
          "flags": 3
         }
        ]
       }
      ]
     },
     "expect": [
      "ok"
     ]
    },
    {
     "wrapper": {
      "mode": 0,
      "txs": [
       {
        "label": "B",
        "type": 6,
        "sender": "bob",
        "frames": [
         {
          "mode": 4,
          "deps": [
           [
            16,
            "msg-B-0",
            "pk-bob"
           ]
          ],
          "exec_gas": 3000,
          "data_size": 96
         },
         {
          "mode": 1,
          "flags": 3
         }
        ]
       }
      ]
     },
     "expect": [
      "ok"
     ]
    },
    {
     "aggregate": {},
     "expect": [
      "A",
      "B"
     ],
     "expect_deps": [
      [
       16,
       "msg-A-0",
       "pk-alice"
      ],
      [
       16,
       "msg-B-0",
       "pk-bob"
      ]
     ]
    }
   ],
   "derivation": "Both by tip, equal, then by admission; deps sorted by data_hash."
