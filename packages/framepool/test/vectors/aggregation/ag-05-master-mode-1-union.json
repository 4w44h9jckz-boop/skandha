{
 "clause": "AG-5",
 "also": [
  "AG-6"
 ],
 "document": "05-aggregation.md",
 "version": 4,
 "operation": "pool",
 "distinguishes": "Under eip-8288-master a mode 1 wrapper's deps must hold every dependency of each transaction it carries or the node holds by hash, and nothing more once every entry resolves; under eip-8288 its transactions are not checked against its deps. An implementation that skips check 5 under the master profile, or refuses for a hash it cannot resolve, fails here.",
 "cases": [
  {
   "name": "a mode 1 wrapper whose deps leave out a carried transaction's",
   "profile": "eip-8288-master",
   "state": {
    "alice": {
     "balance": 1000000000
    },
    "bob": {
     "balance": 1000000000
    },
    "carol": {
     "balance": 1000000000
    }
   },
   "steps": [
    {
     "wrapper": {
      "mode": 1,
      "txs": [
       {
        "label": "A",
        "type": 6,
        "sender": "alice",
        "frames": [
         {
          "mode": 4,
          "deps": [
           [
            16,
            "msg-A-0",
            "pk-alice"
           ]
          ],
          "exec_gas": 3000,
          "data_size": 96
         },
         {
          "mode": 1,
          "flags": 3
         }
        ]
       },
       {
        "label": "B",
        "type": 6,
        "sender": "bob",
        "frames": [
         {
          "mode": 4,
          "deps": [
           [
            16,
            "msg-B-0",
            "pk-bob"
           ]
          ],
          "exec_gas": 3000,
          "data_size": 96
         },
         {
          "mode": 1,
          "flags": 3
         }
        ]
       }
      ],
      "deps": [
       [
        16,
        "msg-A-0",
        "pk-alice"
       ]
      ]
     },
     "expect": "ErrWrapperDeps"
    }
   ],
   "derivation": "B's dependency is not in deps."
  },
  {
   "name": "the same wrapper under eip-8288",
   "profile": "eip-8288",
   "state": {
    "alice": {
     "balance": 1000000000
    },
    "bob": {
     "balance": 1000000000
    },
    "carol": {
     "balance": 1000000000
    }
   },
   "steps": [
    {
     "wrapper": {
      "mode": 1,
      "txs": [
       {
        "label": "A",
        "type": 6,
        "sender": "alice",
        "frames": [
         {
          "mode": 3,
          "deps": [
           [
            16,
            "msg-A-0",
            "pk-alice"
           ]
          ],
          "exec_gas": 3000,
          "data_size": 96
         },
         {
          "mode": 1,
          "flags": 3
         }
        ]
       },
       {
        "label": "B",
        "type": 6,
        "sender": "bob",
        "frames": [
         {
          "mode": 3,
          "deps": [
           [
            16,
            "msg-B-0",
            "pk-bob"
           ]
          ],
          "exec_gas": 3000,
          "data_size": 96
         },
         {
          "mode": 1,
          "flags": 3
         }
        ]
       }
      ],
      "deps": [
       [
        16,
        "msg-A-0",
        "pk-alice"
       ]
      ]
     },
     "expect": [
      "ok",
      "ErrFrameDepsUnproven"
     ]
    }
   ],
   "derivation": "Not checked against its transactions: B is offered to the pool and AG-6 refuses it."
  },
