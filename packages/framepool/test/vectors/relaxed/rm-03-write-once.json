{
 "clause": "RM-3",
 "document": "15-relaxed-mempool.md",
 "version": 1,
 "also": [
  "FP-9",
  "FP-15",
  "RM-6"
 ],
 "operation": "pool",
 "distinguishes": "A read outside the sender is allowed at a slot the account's code declares write-once: any number of readers of a set slot, one relaxed reader of an unset one, which the reader may replace; a write to the unset slot drops its reader and makes it set; a write to a set slot drops every reader whose prefix no longer holds, and throttles the code. An undeclared slot or an undeclared code stays refused, and a banned code's slots are not read. A pool that allows other reads, or holds two readers of an unset slot, fails here.",
