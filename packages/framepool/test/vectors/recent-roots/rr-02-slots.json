  "version": 2,
  "also": ["RR-5"],
  "operation": "pool",
  "distinguishes": "The pool's current slot is its head's slot plus one, so a root of the head's own slot is referenceable and one of the next is not, and a reference's age is counted in slots, not in block numbers or seconds.",
  "cases": [
    {"name": "a root of the head's slot is referenceable, one of the next slot is in the future", "profile": "eip-8272", "head": {"slot": 10}, "state": {"alice": {"balance": 1000000000000}, "bob": {"balance": 1000000000000}, "0x0000000000000000000000000000000000008272": {"code": "recent-root"}}, "roots": [["pool", "0", 10, "r10"]], "steps": [{"add": [{"label": "s10", "type": 6, "sender": "alice", "frames": [{"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 72, "exec_gas": 8000, "roots": [["pool/0", 10, "r10"]]}, {"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 2, "exec_gas": 50000}]}, {"label": "s11", "type": 6, "sender": "bob", "frames": [{"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 72, "exec_gas": 8000, "roots": [["pool/0", 11, "r10"]]}, {"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 2, "exec_gas": 50000}]}], "expect": ["ok", "ErrFrameRootFuture"]}], "derivation": "Current slot 11. Slot 10 < 11; slot 11 >= 11."},
    {"name": "age counts slots: a head at block 100 but slot 8200 sees slot 9 as 8192 old", "profile": "eip-8272", "head": {"number": 100, "slot": 8200}, "state": {"alice": {"balance": 1000000000000}, "bob": {"balance": 1000000000000}, "0x0000000000000000000000000000000000008272": {"code": "recent-root"}}, "roots": [["pool", "0", 9, "r9"], ["pool", "0", 10, "r10"]], "steps": [{"add": [{"label": "s9", "type": 6, "sender": "alice", "frames": [{"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 72, "exec_gas": 8000, "roots": [["pool/0", 9, "r9"]]}, {"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 2, "exec_gas": 50000}]}, {"label": "s10", "type": 6, "sender": "bob", "frames": [{"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 72, "exec_gas": 8000, "roots": [["pool/0", 10, "r10"]]}, {"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 2, "exec_gas": 50000}]}], "expect": ["ErrFrameRootExpired", "ok"]}], "derivation": "Current slot 8201. Ages 8192 and 8191 against W = 8191."},
    {"name": "a block built on a head is at the next slot, and the pool's current slot follows it", "profile": "eip-8272", "head": {"slot": 10}, "state": {"alice": {"balance": 1000000000000}, "bob": {"balance": 1000000000000}, "carol": {"balance": 1000000000000}, "0x0000000000000000000000000000000000008272": {"code": "recent-root"}}, "roots": [["pool", "0", 10, "r10"]], "steps": [{"build": {}, "expect": []}, {"add": [{"label": "s11", "type": 6, "sender": "alice", "frames": [{"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 72, "exec_gas": 8000, "roots": [["pool/0", 11, "r10"]]}, {"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 2, "exec_gas": 50000}]}, {"label": "s12", "type": 6, "sender": "bob", "frames": [{"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 72, "exec_gas": 8000, "roots": [["pool/0", 12, "r10"]]}, {"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 2, "exec_gas": 50000}]}, {"label": "s10", "type": 6, "sender": "carol", "frames": [{"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 72, "exec_gas": 8000, "roots": [["pool/0", 10, "r10"]]}, {"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 2, "exec_gas": 50000}]}], "expect": ["ErrFrameRootUnknown", "ErrFrameRootFuture", "ok"]}], "derivation": "The empty block is at slot 11, so the current slot is 12: slot 11 is in the past but holds no entry, slot 12 is the current one."}
  ]
}
