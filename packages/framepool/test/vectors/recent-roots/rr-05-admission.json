{
  "clause": "RR-5",
  "document": "08-recent-roots.md",
  "version": 2,
  "also": ["FP-8"],
  "operation": "pool",
  "distinguishes": "The verifier frame is evaluated directly: the code at the address first, then each tuple in order, refused for a slot at or after the current one, then for an age above W less the margin, then for an entry that is not exactly (source, slot, root); then its own revert.",
  "cases": [
    {"name": "other code at the address", "profile": "eip-8272", "head": {"slot": 10}, "state": {"alice": {"balance": 1000000000000}, "bob": {"balance": 1000000000000}, "0x0000000000000000000000000000000000008272": {"code": "something-else"}}, "roots": [["pool", "0", 9, "r9"]], "steps": [{"add": [{"label": "s", "type": 6, "sender": "alice", "frames": [{"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 72, "exec_gas": 8000, "roots": [["pool/0", 9, "r9"]]}, {"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 2, "exec_gas": 50000}]}], "expect": ["ErrFramePrefixReverted"]}]},
    {"name": "ages W and W + 1", "profile": "eip-8272", "head": {"slot": 8200}, "state": {"alice": {"balance": 1000000000000}, "bob": {"balance": 1000000000000}, "0x0000000000000000000000000000000000008272": {"code": "recent-root"}}, "roots": [["pool", "0", 9, "r9"], ["pool", "0", 10, "r10"]], "steps": [{"add": [{"label": "old", "type": 6, "sender": "alice", "frames": [{"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 72, "exec_gas": 8000, "roots": [["pool/0", 9, "r9"]]}, {"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 2, "exec_gas": 50000}]}, {"label": "edge", "type": 6, "sender": "bob", "frames": [{"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 72, "exec_gas": 8000, "roots": [["pool/0", 10, "r10"]]}, {"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 2, "exec_gas": 50000}]}], "expect": ["ErrFrameRootExpired", "ok"]}]},
    {"name": "a wrong root, source or slot", "profile": "eip-8272", "head": {"slot": 10}, "state": {"alice": {"balance": 1000000000000}, "bob": {"balance": 1000000000000}, "carol": {"balance": 1000000000000}, "0x0000000000000000000000000000000000008272": {"code": "recent-root"}}, "roots": [["pool", "0", 9, "r9"]], "steps": [{"add": [{"label": "root", "type": 6, "sender": "alice", "frames": [{"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 72, "exec_gas": 8000, "roots": [["pool/0", 9, "x"]]}, {"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 2, "exec_gas": 50000}]}, {"label": "source", "type": 6, "sender": "bob", "frames": [{"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 72, "exec_gas": 8000, "roots": [["pool/1", 9, "r9"]]}, {"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 2, "exec_gas": 50000}]}, {"label": "slot", "type": 6, "sender": "carol", "frames": [{"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 72, "exec_gas": 8000, "roots": [["pool/0", 8, "r9"]]}, {"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 2, "exec_gas": 50000}]}], "expect": ["ErrFrameRootUnknown", "ErrFrameRootUnknown", "ErrFrameRootUnknown"]}]},
    {"name": "a stale occupant of the same index does not satisfy a tuple", "profile": "eip-8272", "head": {"slot": 8201}, "state": {"alice": {"balance": 1000000000000}, "bob": {"balance": 1000000000000}, "0x0000000000000000000000000000000000008272": {"code": "recent-root"}}, "roots": [["pool", "0", 9, "r9"]], "steps": [{"add": [{"label": "s", "type": 6, "sender": "alice", "frames": [{"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 72, "exec_gas": 8000, "roots": [["pool/0", 8201, "r9"]]}, {"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 2, "exec_gas": 50000}]}], "expect": ["ErrFrameRootUnknown"]}], "derivation": "8201 mod 8192 = 9, so slot 8201's index holds slot 9's entry, which commits to slot 9. Current slot 8202, age 1."},
    {"name": "tuples are checked in order, and the first failure answers", "profile": "eip-8272", "head": {"slot": 10}, "state": {"alice": {"balance": 1000000000000}, "bob": {"balance": 1000000000000}, "0x0000000000000000000000000000000000008272": {"code": "recent-root"}}, "roots": [["pool", "0", 9, "r9"]], "steps": [{"add": [{"label": "unknown-first", "type": 6, "sender": "alice", "frames": [{"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 144, "exec_gas": 8000, "roots": [["pool/0", 9, "x"], ["pool/0", 20, "r9"]]}, {"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 2, "exec_gas": 50000}]}, {"label": "future-first", "type": 6, "sender": "bob", "frames": [{"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 144, "exec_gas": 8000, "roots": [["pool/0", 20, "r9"], ["pool/0", 9, "x"]]}, {"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 2, "exec_gas": 50000}]}], "expect": ["ErrFrameRootUnknown", "ErrFrameRootFuture"]}]},
    {"name": "the frame's revert comes after its tuples", "profile": "eip-8272", "head": {"slot": 10}, "state": {"alice": {"balance": 1000000000000}, "bob": {"balance": 1000000000000}, "0x0000000000000000000000000000000000008272": {"code": "recent-root"}}, "roots": [["pool", "0", 9, "r9"]], "steps": [{"add": [{"label": "reverts", "type": 6, "sender": "alice", "frames": [{"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 72, "exec_gas": 8000, "roots": [["pool/0", 9, "r9"]], "reverts": true}, {"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 2, "exec_gas": 50000}]}, {"label": "both", "type": 6, "sender": "bob", "frames": [{"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 72, "exec_gas": 8000, "roots": [["pool/0", 9, "x"]], "reverts": true}, {"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 2, "exec_gas": 50000}]}], "expect": ["ErrFramePrefixReverted", "ErrFrameRootUnknown"]}]},
    {"name": "a margin of 2 refuses ages above W - 2", "profile": "eip-8272", "config": {"frame": {"root_margin": 2}}, "head": {"slot": 8200}, "state": {"alice": {"balance": 1000000000000}, "bob": {"balance": 1000000000000}, "0x0000000000000000000000000000000000008272": {"code": "recent-root"}}, "roots": [["pool", "0", 11, "r11"], ["pool", "0", 12, "r12"]], "steps": [{"add": [{"label": "in", "type": 6, "sender": "alice", "frames": [{"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 72, "exec_gas": 8000, "roots": [["pool/0", 11, "r11"]]}, {"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 2, "exec_gas": 50000}]}, {"label": "out", "type": 6, "sender": "bob", "frames": [{"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 72, "exec_gas": 8000, "roots": [["pool/0", 12, "r12"]]}, {"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 2, "exec_gas": 50000}]}], "expect": ["ErrFrameRootExpired", "ok"]}], "derivation": "Current slot 8201: ages 8190 and 8189 against 8191 - 2 = 8189."}
  ]
}
