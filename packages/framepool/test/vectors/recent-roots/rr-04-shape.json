{
  "clause": "RR-4",
  "document": "08-recent-roots.md",
  "version": 2,
  "also": ["FP-3", "FP-5", "FP-6"],
  "operation": "pool",
  "distinguishes": "Only a VERIFY frame to the recent root address with flags, value and state limit 0 and one to sixteen 72-byte tuples is the verifier frame; there is at most one, first or right after an expiry frame; FP-5's shapes are matched with both skipped; and its gas counts toward max_verify_gas.",
  "cases": [
    {"name": "first, with one tuple", "profile": "eip-8272", "head": {"slot": 10}, "state": {"alice": {"balance": 1000000000000}, "bob": {"balance": 1000000000000}, "0x0000000000000000000000000000000000008272": {"code": "recent-root"}}, "roots": [["pool", "0", 9, "r9"]], "steps": [{"add": [{"label": "s", "type": 6, "sender": "alice", "frames": [{"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 72, "exec_gas": 8000, "roots": [["pool/0", 9, "r9"]]}, {"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 2, "exec_gas": 50000}]}], "expect": ["ok"]}]},
    {"name": "second, after an expiry frame", "profile": "eip-8272", "head": {"slot": 10}, "state": {"alice": {"balance": 1000000000000}, "bob": {"balance": 1000000000000}, "0x0000000000000000000000000000000000008272": {"code": "recent-root"}, "0x81413f0cF12e9b6a49B1D0439E081c577D57FfFf": {"code": "expiry-verifier"}}, "roots": [["pool", "0", 9, "r9"]], "steps": [{"add": [{"label": "s", "type": 6, "sender": "alice", "frames": [{"mode": 1, "target": "0x81413f0cF12e9b6a49B1D0439E081c577D57FfFf", "data_size": 8, "deadline": 2000}, {"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 72, "exec_gas": 8000, "roots": [["pool/0", 9, "r9"]]}, {"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 2, "exec_gas": 50000}]}], "expect": ["ok"]}]},
    {"name": "before an expiry frame is the expiry frame's error", "profile": "eip-8272", "head": {"slot": 10}, "state": {"alice": {"balance": 1000000000000}, "bob": {"balance": 1000000000000}, "0x0000000000000000000000000000000000008272": {"code": "recent-root"}, "0x81413f0cF12e9b6a49B1D0439E081c577D57FfFf": {"code": "expiry-verifier"}}, "roots": [["pool", "0", 9, "r9"]], "steps": [{"add": [{"label": "s", "type": 6, "sender": "alice", "frames": [{"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 72, "exec_gas": 8000, "roots": [["pool/0", 9, "r9"]]}, {"mode": 1, "target": "0x81413f0cF12e9b6a49B1D0439E081c577D57FfFf", "data_size": 8, "deadline": 2000}, {"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 2, "exec_gas": 50000}]}], "expect": ["ErrFrameExpiryNotFirst"]}]},
    {"name": "two verifier frames, or one after the account's validation, are refused", "profile": "eip-8272", "head": {"slot": 10}, "state": {"alice": {"balance": 1000000000000}, "bob": {"balance": 1000000000000}, "0x0000000000000000000000000000000000008272": {"code": "recent-root"}}, "roots": [["pool", "0", 9, "r9"]], "steps": [{"add": [{"label": "two", "type": 6, "sender": "alice", "frames": [{"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 72, "exec_gas": 8000, "roots": [["pool/0", 9, "r9"]]}, {"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 72, "exec_gas": 8000, "roots": [["pool/0", 9, "r9"]]}, {"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 2, "exec_gas": 50000}]}, {"label": "late", "type": 6, "sender": "bob", "frames": [{"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 72, "exec_gas": 8000, "roots": [["pool/0", 9, "r9"]]}, {"mode": 2, "exec_gas": 50000}]}], "expect": ["ErrFrameRootPosition", "ErrFrameRootPosition"]}]},
    {"name": "sixteen tuples, all one, are admitted; seventeen make it no verifier frame", "profile": "eip-8272", "head": {"slot": 10}, "state": {"alice": {"balance": 1000000000000}, "bob": {"balance": 1000000000000}, "0x0000000000000000000000000000000000008272": {"code": "recent-root"}}, "roots": [["pool", "0", 9, "r9"]], "steps": [{"add": [{"label": "16", "type": 6, "sender": "alice", "frames": [{"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 1152, "exec_gas": 8000, "roots": [["pool/0", 9, "r9"], ["pool/0", 9, "r9"], ["pool/0", 9, "r9"], ["pool/0", 9, "r9"], ["pool/0", 9, "r9"], ["pool/0", 9, "r9"], ["pool/0", 9, "r9"], ["pool/0", 9, "r9"], ["pool/0", 9, "r9"], ["pool/0", 9, "r9"], ["pool/0", 9, "r9"], ["pool/0", 9, "r9"], ["pool/0", 9, "r9"], ["pool/0", 9, "r9"], ["pool/0", 9, "r9"], ["pool/0", 9, "r9"]]}, {"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 2, "exec_gas": 50000}]}, {"label": "17", "type": 6, "sender": "bob", "frames": [{"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 1224, "exec_gas": 8000, "roots": [["pool/0", 9, "r9"], ["pool/0", 9, "r9"], ["pool/0", 9, "r9"], ["pool/0", 9, "r9"], ["pool/0", 9, "r9"], ["pool/0", 9, "r9"], ["pool/0", 9, "r9"], ["pool/0", 9, "r9"], ["pool/0", 9, "r9"], ["pool/0", 9, "r9"], ["pool/0", 9, "r9"], ["pool/0", 9, "r9"], ["pool/0", 9, "r9"], ["pool/0", 9, "r9"], ["pool/0", 9, "r9"], ["pool/0", 9, "r9"], ["pool/0", 9, "r9"]]}, {"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 2, "exec_gas": 50000}]}], "expect": ["ok", "ErrFrameUnrecognizedPrefix"]}], "derivation": "Seventeen tuples are 1224 bytes, above 16 * 72; the frame is a VERIFY frame with flags 0 to an address other than the sender, which FP-5 classifies as none of its classes, so the prefix [frame, self_verify] matches no shape."},
    {"name": "flags 1, a state limit, or 71 bytes make it no verifier frame", "profile": "eip-8272", "head": {"slot": 10}, "state": {"alice": {"balance": 1000000000000}, "bob": {"balance": 1000000000000}, "carol": {"balance": 1000000000000}, "0x0000000000000000000000000000000000008272": {"code": "recent-root"}}, "roots": [["pool", "0", 9, "r9"]], "steps": [{"add": [{"label": "flags", "type": 6, "sender": "alice", "frames": [{"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 72, "exec_gas": 8000, "roots": [["pool/0", 9, "r9"]], "flags": 1}, {"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 2, "exec_gas": 50000}]}, {"label": "state", "type": 6, "sender": "bob", "frames": [{"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 72, "exec_gas": 8000, "roots": [["pool/0", 9, "r9"]], "state_gas": 1}, {"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 2, "exec_gas": 50000}]}, {"label": "71", "type": 6, "sender": "carol", "frames": [{"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 71, "exec_gas": 8000, "roots": [["pool/0", 9, "r9"]]}, {"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 2, "exec_gas": 50000}]}], "expect": ["ErrFrameUnrecognizedPrefix", "ErrFrameUnrecognizedPrefix", "ErrFrameUnrecognizedPrefix"]}], "derivation": "With flags 1 the frame is FP-5's pay frame and ends the prefix, whose shape [pay] is none of the four; the other two are classified as nothing."},
    {"name": "a value on the frame is malformed", "profile": "eip-8272", "head": {"slot": 10}, "state": {"alice": {"balance": 1000000000000}, "bob": {"balance": 1000000000000}, "0x0000000000000000000000000000000000008272": {"code": "recent-root"}}, "roots": [["pool", "0", 9, "r9"]], "steps": [{"add": [{"label": "v", "type": 6, "sender": "alice", "frames": [{"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 72, "exec_gas": 8000, "roots": [["pool/0", 9, "r9"]], "value": 1}, {"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 2, "exec_gas": 50000}]}], "expect": ["ErrFrameMalformed"]}]},
    {"name": "its gas counts toward max_verify_gas", "profile": "eip-8272", "head": {"slot": 10}, "state": {"alice": {"balance": 1000000000000}, "bob": {"balance": 1000000000000}, "0x0000000000000000000000000000000000008272": {"code": "recent-root"}}, "roots": [["pool", "0", 9, "r9"]], "steps": [{"add": [{"label": "at", "type": 6, "sender": "alice", "frames": [{"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 72, "exec_gas": 8000, "roots": [["pool/0", 9, "r9"]]}, {"mode": 1, "flags": 3, "exec_gas": 89200}, {"mode": 2, "exec_gas": 50000}]}, {"label": "over", "type": 6, "sender": "bob", "frames": [{"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 72, "exec_gas": 8000, "roots": [["pool/0", 9, "r9"]]}, {"mode": 1, "flags": 3, "exec_gas": 89201}, {"mode": 2, "exec_gas": 50000}]}], "expect": ["ok", "ErrFrameVerifyGas"]}], "derivation": "8000 + 89200 + 2800 for the signature is 100000; one more is over."},
    {"name": "under eip-8141 the same frame is an ordinary one", "profile": "eip-8141", "head": {"slot": 10}, "state": {"alice": {"balance": 1000000000000}, "bob": {"balance": 1000000000000}, "0x0000000000000000000000000000000000008272": {"code": "recent-root"}}, "roots": [["pool", "0", 9, "r9"]], "steps": [{"add": [{"label": "s", "type": 6, "sender": "alice", "frames": [{"mode": 1, "target": "0x0000000000000000000000000000000000008272", "data_size": 72, "exec_gas": 8000, "roots": [["pool/0", 9, "r9"]]}, {"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 2, "exec_gas": 50000}]}], "expect": ["ErrFrameUnrecognizedPrefix"]}]}
  ]
