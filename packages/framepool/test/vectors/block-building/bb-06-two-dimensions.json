      "name": "under two, the same block uses 150,000 in each dimension and leaves the base fee where it was",
      "head": {"gas_limit": 300000, "gas_used": 150000},
      "state": {"a": {"balance": 100000000}, "b": {"balance": 100000000}, "c": {"balance": 100000000}},
      "steps": [
        {"add": [
          {"label": "a", "sender": "a", "gas": 150000, "state_gas_used": 150000, "tip": 50},
          {"label": "b", "sender": "b", "gas": 150000, "tip": 40}
        ], "expect": ["ok", "ok"]},
        {"build": {"min_tip": 1, "coinbase": "cb", "dimensions": "two"}, "expect": ["a", "b"],
