                "d": {"balance": 100000000}, "e": {"balance": 100000000}, "f": {"balance": 100000000}},
      "steps": [
        {"add": [
          {"label": "a", "sender": "a", "gas": 100000, "state_gas_used": 60000, "tip": 70},
          {"label": "b", "sender": "b", "gas": 100000, "state_gas_used": 60000, "tip": 60},
          {"label": "c", "sender": "c", "gas": 100000, "state_gas_used": 60000, "tip": 50},
          {"label": "d", "sender": "d", "gas": 100000, "state_gas_used": 60000, "tip": 40},
          {"label": "e", "sender": "e", "gas": 100000, "state_gas_used": 60000, "tip": 30},
          {"label": "f", "sender": "f", "gas": 21000, "tip": 20}
        ], "expect": ["ok", "ok", "ok", "ok", "ok", "ok"]},
        {"build": {"min_tip": 1, "coinbase": "cb", "dimensions": "two"}, "expect": ["a", "b", "c", "d", "f"],
         "expect_gas_used": 240000},
        {"expect_pool": {"pending": {"e": ["e"]}}}
      ]
    },
    {
      "name": "under one, neither a type 2 spend nor a frame spend fits 100,000 left",
      "head": {"gas_limit": 300000, "gas_used": 150000},
      "state": {"x1": {"balance": 100000000}, "x2": {"balance": 100000000}, "t": {"balance": 100000000},
                "fs": {"balance": 100000000}, "y": {"balance": 100000000}},
      "steps": [
        {"add": [
          {"label": "x1", "sender": "x1", "gas": 100000, "tip": 90},
