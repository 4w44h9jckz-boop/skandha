{
  "clause": "BB-6",
  "document": "03-block-building.md",
  "version": 4,
  "also": ["BB-3", "BB-4", "FEE-1", "FEE-4"],
  "operation": "pool",
  "distinguishes": "Under the rule two, state gas counted apart from execution gas: what an included transaction adds to each sum, an account-nonce transaction reserving its whole gas in both dimensions where a frame transaction reserves each budget in its own, the loop stopping when either dimension has less than 12,000 left and running down to 12,000 where one would stop at 21,000, and the header's gas used, which the next base fee reads, being the larger sum, and a reverted transaction's gas counted as execution alone.",
  "cases": [
    {
      "name": "under one, state gas fills the single sum",
      "head": {"gas_limit": 300000, "gas_used": 150000},
      "state": {"a": {"balance": 100000000}, "b": {"balance": 100000000}, "c": {"balance": 100000000},
                "d": {"balance": 100000000}, "e": {"balance": 100000000}, "f": {"balance": 100000000}},
      "steps": [
        {"add": [
          {"label": "a", "sender": "a", "gas": 100000, "state_gas_used": 60000, "tip": 70},
          {"label": "b", "sender": "b", "gas": 100000, "state_gas_used": 60000, "tip": 60},
          {"label": "c", "sender": "c", "gas": 100000, "state_gas_used": 60000, "tip": 50},
          {"label": "d", "sender": "d", "gas": 100000, "state_gas_used": 60000, "tip": 40},
          {"label": "e", "sender": "e", "gas": 100000, "state_gas_used": 60000, "tip": 30},
          {"label": "f", "sender": "f", "gas": 21000, "tip": 20}
        ], "expect": ["ok", "ok", "ok", "ok", "ok", "ok"]},
        {"build": {"min_tip": 1, "coinbase": "cb", "dimensions": "one"}, "expect": ["a", "b", "c"],
         "expect_gas_used": 300000},
        {"expect_pool": {"pending": {"d": ["d"], "e": ["e"], "f": ["f"]}}}
      ]
    },
    {
      "name": "under two, state gas takes no execution room, and a head that does not fit its state room is dropped",
      "head": {"gas_limit": 300000, "gas_used": 150000},
