    {
      "name": "under two, a transaction that reverts counts its gas as execution, its declared state gas not at all",
      "head": {"gas_limit": 300000, "gas_used": 150000},
      "state": {"a": {"balance": 100000000}, "b": {"balance": 100000000}},
      "steps": [
        {"add": [
          {"label": "r0", "sender": "a", "to": "round", "gas": 100000, "state_gas_used": 60000, "revert_gas_used": 40000,
           "tip": 20, "pulls": [["i1", 1000]]},
          {"label": "b0", "sender": "b", "gas": 50000, "state_gas_used": 50000}
        ], "expect": ["ok", "ok"]},
        {"build": {"min_tip": 1, "coinbase": "cb", "dimensions": "two"}, "expect": ["r0", "b0"],
         "expect_gas_used": 50000}
      ],
      "derivation": "i1 holds nothing, so r0 reverts at 40000 gas, all of it execution: X = 40000. b0 adds 50000 to S. gas_used = max(40000, 50000) = 50000. Counting r0's state gas, capped at the 40000 it used, would give S = 90000."
    }
  ]
