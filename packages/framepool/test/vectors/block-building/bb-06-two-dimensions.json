        {"add": [{"label": "c", "sender": "c", "max_fee": 10, "tip": 1}], "expect": ["ok"]},
        {"build": {"min_tip": 0, "coinbase": "cb", "dimensions": "two"}, "expect": ["c"]}
      ]
