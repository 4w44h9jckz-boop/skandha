{
  "clause": "LU-10",
  "document": "06-lucid.md",
  "version": 3,
  "also": ["MD-11"],
  "operation": "pool",
  "distinguishes": "A full sealed pool under last drops the last in commitment order for a newcomer that comes before it, refuses one that does not, releases the dropped sender, and applies the policy first (an Interpretation, decision record 0014); under unplaced it drops the last that the selection with the newcomer passes over, for a newcomer that comes before it or that the selection takes (a variant, decision record 0015).",
  "cases": [
    {"name": "a newcomer before the last drops it", "sealed": "eip-8184",
     "config": {"sealed": {"st_slots": 2}},
     "state": {"alice": {"balance": 100000000}, "bob": {"balance": 100000000}, "carol": {"balance": 100000000}},
     "steps": [
       {"add": [{"type": "st", "label": "A", "sender": "alice", "max_tob_fee": 100},
                {"type": "st", "label": "B", "sender": "bob", "max_tob_fee": 200}], "expect": ["ok", "ok"]},
       {"add": [{"type": "st", "label": "C", "sender": "carol", "max_tob_fee": 300}], "expect": ["ok"]},
       {"expect_pool": {"pending": {"bob": ["B"], "carol": ["C"]}}}
     ]},
    {"name": "a newcomer after the last is refused", "sealed": "eip-8184",
     "config": {"sealed": {"st_slots": 2}},
     "state": {"alice": {"balance": 100000000}, "bob": {"balance": 100000000}, "carol": {"balance": 100000000}},
     "steps": [
       {"add": [{"type": "st", "label": "A", "sender": "alice", "max_tob_fee": 100},
                {"type": "st", "label": "B", "sender": "bob", "max_tob_fee": 200}], "expect": ["ok", "ok"]},
       {"add": [{"type": "st", "label": "C", "sender": "carol", "max_tob_fee": 50}], "expect": ["ErrUnderpriced"]},
       {"expect_pool": {"pending": {"alice": ["A"], "bob": ["B"]}}}
     ]},
    {"name": "an equal ToB fee and a larger gas limit comes before the last", "sealed": "eip-8184",
     "config": {"sealed": {"st_slots": 2}},
     "state": {"alice": {"balance": 100000000}, "bob": {"balance": 100000000}, "carol": {"balance": 100000000}},
     "steps": [
       {"add": [{"type": "st", "label": "A", "sender": "alice", "max_tob_fee": 100},
                {"type": "st", "label": "B", "sender": "bob", "max_tob_fee": 200}], "expect": ["ok", "ok"]},
       {"add": [{"type": "st", "label": "C", "sender": "carol", "max_tob_fee": 100, "gas_limit": 200000}], "expect": ["ok"]},
       {"expect_pool": {"pending": {"bob": ["B"], "carol": ["C"]}}}
     ]},
    {"name": "an equal ToB fee and a smaller gas limit comes after the last", "sealed": "eip-8184",
     "config": {"sealed": {"st_slots": 2}},
     "state": {"alice": {"balance": 100000000}, "bob": {"balance": 100000000}, "carol": {"balance": 100000000}},
     "steps": [
       {"add": [{"type": "st", "label": "A", "sender": "alice", "max_tob_fee": 100},
                {"type": "st", "label": "B", "sender": "bob", "max_tob_fee": 200}], "expect": ["ok", "ok"]},
       {"add": [{"type": "st", "label": "C", "sender": "carol", "max_tob_fee": 100, "gas_limit": 50000}], "expect": ["ErrUnderpriced"]}
     ]},
    {"name": "the dropped sender is released", "sealed": "eip-8184",
     "config": {"sealed": {"st_slots": 2}},
     "state": {"alice": {"balance": 100000000}, "bob": {"balance": 100000000}, "carol": {"balance": 100000000}},
     "steps": [
       {"add": [{"type": "st", "label": "A", "sender": "alice", "max_tob_fee": 100},
                {"type": "st", "label": "B", "sender": "bob", "max_tob_fee": 200}], "expect": ["ok", "ok"]},
       {"add": [{"type": "st", "label": "C", "sender": "carol", "max_tob_fee": 300}], "expect": ["ok"]},
       {"add": [{"label": "P", "sender": "alice"}], "expect": ["ok"]},
       {"expect_pool": {"pending": {"alice": ["P"], "bob": ["B"], "carol": ["C"]}}}
     ]},
    {"name": "the policy before the capacity", "sealed": "eip-8184",
     "config": {"sealed": {"st_slots": 2, "policy": "next-block"}},
     "state": {"alice": {"balance": 100000000}, "bob": {"balance": 100000000}, "carol": {"balance": 100000000}},
     "steps": [
       {"add": [{"type": "st", "label": "A", "sender": "alice", "max_tob_fee": 300},
                {"type": "st", "label": "B", "sender": "bob", "max_tob_fee": 200}], "expect": ["ok", "ok"]},
       {"add": [{"type": "st", "label": "C", "sender": "carol", "max_tob_fee": 100, "max_preceding": 0}], "expect": ["ErrSTNotIncludable"]}
     ]},
    {"name": "last drops a placed one for one that goes first", "sealed": "eip-8184",
     "config": {"sealed": {"st_slots": 2}},
     "state": {"alice": {"balance": 100000000}, "bob": {"balance": 100000000}, "carol": {"balance": 100000000}},
     "steps": [
       {"add": [{"type": "st", "label": "A", "sender": "alice", "max_tob_fee": 300, "max_preceding": 0},
                {"type": "st", "label": "B", "sender": "bob", "max_tob_fee": 200}], "expect": ["ok", "ok"]},
       {"add": [{"type": "st", "label": "C", "sender": "carol", "max_tob_fee": 400, "max_preceding": 0}], "expect": ["ok"]},
       {"expect_pool": {"pending": {"alice": ["A"], "carol": ["C"]}}}
     ]},
    {"name": "unplaced drops one with no place for one that has one", "sealed": "eip-8184",
     "config": {"sealed": {"st_slots": 2, "evict_first": "unplaced"}},
     "state": {"alice": {"balance": 100000000}, "bob": {"balance": 100000000}, "carol": {"balance": 100000000}},
     "steps": [
       {"add": [{"type": "st", "label": "A", "sender": "alice", "max_tob_fee": 300},
                {"type": "st", "label": "B", "sender": "bob", "max_tob_fee": 200, "max_preceding": 0}], "expect": ["ok", "ok"]},
       {"add": [{"type": "st", "label": "C", "sender": "carol", "max_tob_fee": 100}], "expect": ["ok"]},
       {"expect_pool": {"pending": {"alice": ["A"], "carol": ["C"]}}}
     ]},
    {"name": "unplaced refuses one with no place that comes after the victim", "sealed": "eip-8184",
     "config": {"sealed": {"st_slots": 2, "evict_first": "unplaced"}},
     "state": {"alice": {"balance": 100000000}, "bob": {"balance": 100000000}, "carol": {"balance": 100000000}},
     "steps": [
       {"add": [{"type": "st", "label": "A", "sender": "alice", "max_tob_fee": 300},
                {"type": "st", "label": "B", "sender": "bob", "max_tob_fee": 200, "max_preceding": 0}], "expect": ["ok", "ok"]},
       {"add": [{"type": "st", "label": "C", "sender": "carol", "max_tob_fee": 100, "max_preceding": 0}], "expect": ["ErrUnderpriced"]},
       {"expect_pool": {"pending": {"alice": ["A"], "bob": ["B"]}}}
     ]},
    {"name": "unplaced admits one with no place that comes before the victim", "sealed": "eip-8184",
     "config": {"sealed": {"st_slots": 2, "evict_first": "unplaced"}},
     "state": {"alice": {"balance": 100000000}, "bob": {"balance": 100000000}, "carol": {"balance": 100000000}},
     "steps": [
       {"add": [{"type": "st", "label": "A", "sender": "alice", "max_tob_fee": 300},
                {"type": "st", "label": "B", "sender": "bob", "max_tob_fee": 200, "max_preceding": 0}], "expect": ["ok", "ok"]},
       {"add": [{"type": "st", "label": "C", "sender": "carol", "max_tob_fee": 250, "max_preceding": 0}], "expect": ["ok"]},
       {"expect_pool": {"pending": {"alice": ["A"], "carol": ["C"]}}}
     ]},
    {"name": "unplaced with every one placed refuses one after the last", "sealed": "eip-8184",
     "config": {"sealed": {"st_slots": 2, "evict_first": "unplaced"}},
     "state": {"alice": {"balance": 100000000}, "bob": {"balance": 100000000}, "carol": {"balance": 100000000}},
     "steps": [
       {"add": [{"type": "st", "label": "A", "sender": "alice", "max_tob_fee": 300},
                {"type": "st", "label": "B", "sender": "bob", "max_tob_fee": 200}], "expect": ["ok", "ok"]},
       {"add": [{"type": "st", "label": "C", "sender": "carol", "max_tob_fee": 100}], "expect": ["ErrUnderpriced"]},
       {"expect_pool": {"pending": {"alice": ["A"], "bob": ["B"]}}}
     ]},
    {"name": "unplaced picks the victim with the newcomer in the selection", "sealed": "eip-8184",
     "config": {"sealed": {"st_slots": 2, "evict_first": "unplaced"}},
     "state": {"alice": {"balance": 100000000}, "bob": {"balance": 100000000}, "carol": {"balance": 100000000}},
     "steps": [
       {"add": [{"type": "st", "label": "A", "sender": "alice", "max_tob_fee": 300, "max_preceding": 0},
                {"type": "st", "label": "B", "sender": "bob", "max_tob_fee": 200}], "expect": ["ok", "ok"]},
       {"add": [{"type": "st", "label": "C", "sender": "carol", "max_tob_fee": 400, "max_preceding": 0}], "expect": ["ok"]},
       {"expect_pool": {"pending": {"bob": ["B"], "carol": ["C"]}}}
     ]}
  ]
}
