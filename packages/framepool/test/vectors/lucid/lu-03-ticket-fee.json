{
  "clause": "LU-3",
  "document": "06-lucid.md",
  "version": 1,
  "operation": "ticket_fee",
  "distinguishes": "The order in which a ticket's fees come out of max_fee times gas_limit: the base fee and the key fee, then the priority fee, then the ToB fee, each capped; and whether the ticket can pay at all.",
  "cases": [
    {"name": "aa's worked example: every fee at its cap",
     "st": {"type": "st", "gas_limit": 200000, "max_fee": 5000000000, "tip": 1000000000, "key_fee": 100000000000000, "max_tob_fee": 1000000000000000},
     "base_fee": 1000000000,
     "expect": {"can_pay": true, "priority": 200000000000000, "tob": 500000000000000, "ticket_fee": 1000000000000000, "cost": 1000000000000000}},
    {"name": "the ToB fee capped by max_tob_fee",
     "st": {"type": "st", "max_tob_fee": 50000},
     "base_fee": 10,
     "expect": {"can_pay": true, "priority": 1000000, "tob": 50000, "ticket_fee": 2050000, "cost": 10000000}},
    {"name": "the priority fee squeezed by the key fee, leaving no ToB fee",
     "st": {"type": "st", "max_fee": 12, "key_fee": 50000, "max_tob_fee": 1000000},
     "base_fee": 10,
     "expect": {"can_pay": true, "priority": 150000, "tob": 0, "ticket_fee": 1200000, "cost": 1200000}},
    {"name": "a small tip leaves the remainder to the ToB fee",
     "st": {"type": "st", "gas_limit": 1000, "tip": 1, "max_tob_fee": 1000000000},
     "base_fee": 10,
     "expect": {"can_pay": true, "priority": 1000, "tob": 89000, "ticket_fee": 100000, "cost": 100000}},
    {"name": "a fee cap exactly at the base fee can pay, and pays nothing more",
     "st": {"type": "st", "max_fee": 10, "max_tob_fee": 1000},
     "base_fee": 10,
     "expect": {"can_pay": true, "priority": 0, "tob": 0, "ticket_fee": 1000000, "cost": 1000000}},
    {"name": "one wei of key fee more than the cap holds: can not pay",
     "st": {"type": "st", "max_fee": 10, "key_fee": 1},
     "base_fee": 10,
     "expect": {"can_pay": false, "cost": 1000000}},
    {"name": "a fee cap below the base fee can not pay",
     "st": {"type": "st", "max_fee": 9},
     "base_fee": 10,
     "expect": {"can_pay": false, "cost": 900000}}
  ]
}
