{
 "clause": "DS-1",
 "also": [],
 "document": "13-descriptors.md",
 "version": 1,
 "operation": "descriptor",
 "distinguishes": "A descriptor is a JSON object with exactly six members whose values are objects, arrays, ASCII strings, booleans, null and integers from 0 to 2^53 - 1: a loader that accepts a float, an exponent, a negative or too large integer, a non-ASCII or control character, a repeated member name, a missing or extra member, another format, or text that is not an object, fails here.",
 "cases": [
  {
   "name": "a well-formed child loads",
   "store": [
    {
     "file": "docs/spec/descriptors/eip-8141.json"
    }
   ],
   "text": "{\"format\": 1, \"name\": \"tip floor 2\", \"source\": \"a vector\", \"parent\": \"bafkreic7kyifykopewlbznmhicjvfrmbxhmfwaaxglrdcgrttm2qw5blb4\", \"remove\": [], \"rules\": {\"FP-3\": {\"price_limit\": 2}}}",
   "expect": {
    "result": "ok"
   },
   "derivation": "Every member of DS-1 is there and every value is of an allowed kind."
  },
  {
   "name": "a float",
   "store": [
    {
     "file": "docs/spec/descriptors/eip-8141.json"
    }
   ],
   "text": "{\"format\": 1, \"name\": \"tip floor 2\", \"source\": \"a vector\", \"parent\": \"bafkreic7kyifykopewlbznmhicjvfrmbxhmfwaaxglrdcgrttm2qw5blb4\", \"remove\": [], \"rules\": {\"FP-3\": {\"price_limit\": 2.5}}}",
   "expect": {
    "result": "ErrDescriptorMalformed"
   },
   "derivation": "2.5 is not an integer."
  },
  {
   "name": "an integer written with an exponent",
   "store": [
    {
     "file": "docs/spec/descriptors/eip-8141.json"
    }
   ],
   "text": "{\"format\": 1, \"name\": \"tip floor 2\", \"source\": \"a vector\", \"parent\": \"bafkreic7kyifykopewlbznmhicjvfrmbxhmfwaaxglrdcgrttm2qw5blb4\", \"remove\": [], \"rules\": {\"FP-3\": {\"price_limit\": 2e0}}}",
   "expect": {
    "result": "ErrDescriptorMalformed"
   },
   "derivation": "2e0 is a JSON number that is not written as an integer; DS-1 allows integers only, and a parser reads 2e0 as a float."
  },
  {
   "name": "a negative integer",
   "store": [
    {
     "file": "docs/spec/descriptors/eip-8141.json"
    }
   ],
   "text": "{\"format\": 1, \"name\": \"tip floor 2\", \"source\": \"a vector\", \"parent\": \"bafkreic7kyifykopewlbznmhicjvfrmbxhmfwaaxglrdcgrttm2qw5blb4\", \"remove\": [], \"rules\": {\"FP-3\": {\"price_limit\": -2}}}",
   "expect": {
    "result": "ErrDescriptorMalformed"
   },
   "derivation": "Integers run from 0."
  },
  {
   "name": "an integer of 2^53",
   "store": [
    {
     "file": "docs/spec/descriptors/eip-8141.json"
    }
   ],
   "text": "{\"format\": 1, \"name\": \"tip floor 2\", \"source\": \"a vector\", \"parent\": \"bafkreic7kyifykopewlbznmhicjvfrmbxhmfwaaxglrdcgrttm2qw5blb4\", \"remove\": [], \"rules\": {\"FP-3\": {\"price_limit\": 9007199254740992}}}",
   "expect": {
    "result": "ErrDescriptorMalformed"
   },
   "derivation": "Integers run to 2^53 - 1."
  },
  {
   "name": "a string with a character above 0x7e",
   "store": [
    {
     "file": "docs/spec/descriptors/eip-8141.json"
    }
   ],
   "text": "{\"format\": 1, \"name\": \"tip floor \\u00e9\", \"source\": \"a vector\", \"parent\": \"bafkreic7kyifykopewlbznmhicjvfrmbxhmfwaaxglrdcgrttm2qw5blb4\", \"remove\": [], \"rules\": {\"FP-3\": {\"price_limit\": 2}}}",
   "expect": {
    "result": "ErrDescriptorMalformed"
   },
   "derivation": "The JSON escape decodes to U+00E9, outside 0x20 to 0x7e."
  },
  {
   "name": "a string with a control character",
   "store": [
    {
     "file": "docs/spec/descriptors/eip-8141.json"
    }
   ],
   "text": "{\"format\": 1, \"name\": \"tip\\tfloor\", \"source\": \"a vector\", \"parent\": \"bafkreic7kyifykopewlbznmhicjvfrmbxhmfwaaxglrdcgrttm2qw5blb4\", \"remove\": [], \"rules\": {\"FP-3\": {\"price_limit\": 2}}}",
   "expect": {
    "result": "ErrDescriptorMalformed"
   },
   "derivation": "The escape decodes to a tab, 0x09, below 0x20."
  },
  {
   "name": "a member name twice",
   "store": [
    {
     "file": "docs/spec/descriptors/eip-8141.json"
    }
   ],
   "text": "{\"format\": 1, \"format\": 1, \"name\": \"tip floor 2\", \"source\": \"a vector\", \"parent\": \"bafkreic7kyifykopewlbznmhicjvfrmbxhmfwaaxglrdcgrttm2qw5blb4\", \"remove\": [], \"rules\": {\"FP-3\": {\"price_limit\": 2}}}",
   "expect": {
    "result": "ErrDescriptorMalformed"
   },
   "derivation": "Member names are unique."
  },
  {
   "name": "no remove member",
   "store": [
    {
     "file": "docs/spec/descriptors/eip-8141.json"
    }
   ],
   "text": "{\"format\": 1, \"name\": \"tip floor 2\", \"source\": \"a vector\", \"parent\": \"bafkreic7kyifykopewlbznmhicjvfrmbxhmfwaaxglrdcgrttm2qw5blb4\", \"rules\": {\"FP-3\": {\"price_limit\": 2}}}",
   "expect": {
    "result": "ErrDescriptorMalformed"
   },
   "derivation": "DS-1 lists exactly six members."
  },
  {
   "name": "an extra member",
   "store": [
    {
     "file": "docs/spec/descriptors/eip-8141.json"
    }
   ],
   "text": "{\"format\": 1, \"name\": \"tip floor 2\", \"source\": \"a vector\", \"parent\": \"bafkreic7kyifykopewlbznmhicjvfrmbxhmfwaaxglrdcgrttm2qw5blb4\", \"remove\": [], \"rules\": {\"FP-3\": {\"price_limit\": 2}}, \"extra\": 1}",
   "expect": {
    "result": "ErrDescriptorMalformed"
   },
   "derivation": "DS-1 lists exactly six members."
  },
  {
   "name": "format 2",
   "store": [
    {
     "file": "docs/spec/descriptors/eip-8141.json"
    }
   ],
   "text": "{\"format\": 2, \"name\": \"tip floor 2\", \"source\": \"a vector\", \"parent\": \"bafkreic7kyifykopewlbznmhicjvfrmbxhmfwaaxglrdcgrttm2qw5blb4\", \"remove\": [], \"rules\": {\"FP-3\": {\"price_limit\": 2}}}",
   "expect": {
    "result": "ErrDescriptorMalformed"
   },
   "derivation": "format is the integer 1."
  },
  {
   "name": "not an object",
   "store": [
    {
     "file": "docs/spec/descriptors/eip-8141.json"
    }
   ],
   "text": "[1]",
   "expect": {
    "result": "ErrDescriptorMalformed"
   },
   "derivation": "A descriptor is a JSON object."
  },
  {
   "name": "not JSON",
   "store": [
    {
     "file": "docs/spec/descriptors/eip-8141.json"
    }
   ],
   "text": "{",
   "expect": {
    "result": "ErrDescriptorMalformed"
   },
   "derivation": "Not RFC 8259 JSON."
  }
 ]
}
