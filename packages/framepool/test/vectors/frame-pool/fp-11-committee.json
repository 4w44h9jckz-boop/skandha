       "frames": [
        {
         "mode": 1,
         "flags": 3,
         "exec_gas": 122006,
         "data_size": 288,
         "approves": 3
        },
        {
         "mode": 2,
         "target": "results-store",
         "exec_gas": 40000,
         "data_size": 64
        }
       ]
      }
     ],
     "expect": [
      "ErrFrameVerifyGas"
     ]
    }
   ],
   "derivation": "The VERIFY frame's 122006 gas is above max_verify_gas, 100000 (FP-6)."
