       {"label": "enough", "type": 6, "sender": "bob", "nonce_keys": [115792089237316195423570985008687907853269984665640564039457584007913129639935], "frames": [{"mode": 1, "target": "0x81413f0cF12e9b6a49B1D0439E081c577D57FfFf", "data_size": 8, "deadline": 1030}, {"mode": 1, "flags": 3, "exec_gas": 13000}, {"mode": 2, "exec_gas": 50000}]}
