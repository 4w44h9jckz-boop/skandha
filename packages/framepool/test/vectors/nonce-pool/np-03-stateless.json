{
  "clause": "NP-3",
  "document": "01-nonce-pool.md",
  "version": 1,
  "also": ["MD-11"],
  "operation": "pool",
  "distinguishes": "Each stateless check and the order between them: a transaction failing several checks reports the earliest.",
  "cases": [
    {"name": "blob transactions belong to another pool", "state": {"alice": {"balance": 100000000}},
     "steps": [{"add": [{"label": "t", "sender": "alice", "type": 3}], "expect": ["ErrTxTypeNotSupported"]}]},
    {"name": "an unknown type: 6 would go to the frame pool, so 5 stands in", "state": {"alice": {"balance": 100000000}},
     "steps": [{"add": [{"label": "t", "sender": "alice", "type": 5}], "expect": ["ErrTxTypeNotSupported"]}]},
    {"name": "size at the limit is admitted, one byte over is not", "state": {"alice": {"balance": 100000000}},
     "steps": [{"add": [{"label": "t1", "sender": "alice", "size": 131072}, {"label": "t2", "sender": "alice", "nonce": 1, "size": 131073}], "expect": ["ok", "ErrOversizedData"]}]},
    {"name": "initcode over 49152 bytes, before any gas check", "state": {"alice": {"balance": 100000000}},
     "steps": [{"add": [{"label": "t", "sender": "alice", "to": null, "data_size": 49153}], "expect": ["ErrMaxInitCodeSizeExceeded"]}]},
    {"name": "the EIP-7825 cap is checked before the block gas limit", "state": {"alice": {"balance": 100000000000}},
     "steps": [{"add": [{"label": "t", "sender": "alice", "gas": 16777217}], "expect": ["ErrGasLimitTooHigh"]}]},
    {"name": "gas above the head's gas limit", "head": {"gas_limit": 1000000, "gas_used": 500000}, "state": {"alice": {"balance": 1000000000}},
     "steps": [{"add": [{"label": "t", "sender": "alice", "gas": 1000001}], "expect": ["ErrGasLimit"]}]},
    {"name": "negative value", "state": {"alice": {"balance": 100000000}},
     "steps": [{"add": [{"label": "t", "sender": "alice", "value": -1}], "expect": ["ErrNegativeValue"]}]},
    {"name": "tip above fee cap, reported before an intrinsic gas failure", "state": {"alice": {"balance": 100000000}},
     "steps": [{"add": [{"label": "t", "sender": "alice", "tip": 101, "gas": 20000}], "expect": ["ErrTipAboveFeeCap"]}]},
    {"name": "no recoverable sender", "state": {"alice": {"balance": 100000000}},
     "steps": [{"add": [{"label": "t", "sender": "alice", "valid_signature": false}], "expect": ["ErrInvalidSender"]}]},
    {"name": "nonce at 2^64 - 1", "state": {"alice": {"balance": 100000000}},
     "steps": [{"add": [{"label": "t", "sender": "alice", "nonce": 18446744073709551615}], "expect": ["ErrNonceMax"]}]},
    {"name": "below intrinsic gas, reported before a low tip", "state": {"alice": {"balance": 100000000}},
     "steps": [{"add": [{"label": "t", "sender": "alice", "gas": 20999, "tip": 0}], "expect": ["ErrIntrinsicGas"]}]},
    {"name": "above intrinsic gas but below the calldata floor", "state": {"alice": {"balance": 100000000}},
     "steps": [{"add": [{"label": "t1", "sender": "alice", "data_size": 100, "gas": 24999}, {"label": "t2", "sender": "alice", "data_size": 100, "gas": 25000}], "expect": ["ErrFloorDataGas", "ok"]}]},
    {"name": "tip below price_limit", "state": {"alice": {"balance": 100000000}},
     "steps": [{"add": [{"label": "t", "sender": "alice", "tip": 0}], "expect": ["ErrTxGasPriceTooLow"]}]},
    {"name": "set code without authorizations", "state": {"alice": {"balance": 100000000}},
     "steps": [{"add": [{"label": "t", "sender": "alice", "type": 4}], "expect": ["ErrEmptyAuthList"]}]}
  ]
}
