  "distinguishes": "An includer at the surface lists frame transactions from its own pool, mined withdrawals from their bytes, up to its list's verify budget, by the same rule under either fill.",
  "cases": [
    {
      "name": "an includer holding three withdrawals lists two: a third does not fit what remains of its list's budget",
      "profile": "hegota-testnet",
      "focil": "eip-8369",
      "head": {
        "number": 304239,
        "slot": 323056,
        "timestamp": 1791360787,
        "gas_limit": 200000000,
        "gas_used": 0,
        "base_fee": 7
      },
      "state": {
        "0x73e47a8da2c83beb802708fc473b5b7d094f3ee6": {
          "balance": 1000000000000000000,
          "code": "privacy-pool"
        }
      },
      "steps": [
        {
          "rpc": "",
          "as": "w3",
          "client": {
            "valid": true
          },
          "expect": {
            "result": "ok"
          }
        },
        {
          "rpc": "",
          "as": "w1",
          "client": {
            "valid": true
          },
          "expect": {
            "result": "ok"
          }
