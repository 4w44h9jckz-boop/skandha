{
  "clause": "IL-5",
  "document": "07-focil.md",
  "version": 2,
  "operation": "pool",
  "distinguishes": "Valid at the end of the payload: the sender's nonce, a balance covering gas limit times fee cap plus value, a fee cap at least the block's base fee, no frame transaction under eip-7805, and under eip-8369 a frame transaction whose prefix still simulates against the post-state.",
  "cases": [
    {"name": "valid: leaving it out is the omission",
     "focil": "eip-7805",
     "state": {"alice": {"balance": 100000000}},
     "steps": [{"build": {"skip": ["alice"], "ils": [[{"label": "a0", "sender": "alice"}]]}, "expect": [], "expect_omission": "a0"}]},
    {"name": "a nonce ahead of the sender's is not valid",
     "focil": "eip-7805",
     "state": {"alice": {"balance": 100000000}},
     "steps": [{"build": {"skip": ["alice"], "ils": [[{"label": "a1", "sender": "alice", "nonce": 1}]]}, "expect": [], "expect_omission": null}]},
    {"name": "a balance one short of 2100000 is not",
     "focil": "eip-7805",
     "state": {"poor": {"balance": 2099999}},
     "steps": [{"build": {"skip": ["poor"], "ils": [[{"label": "p0", "sender": "poor"}]]}, "expect": [], "expect_omission": null}]},
    {"name": "a balance of exactly 2100000 is",
     "focil": "eip-7805",
     "state": {"just": {"balance": 2100000}},
     "steps": [{"build": {"skip": ["just"], "ils": [[{"label": "j0", "sender": "just"}]]}, "expect": [], "expect_omission": "j0"}]},
    {"name": "a fee cap of 10 under a block base fee of 11 is not",
     "focil": "eip-7805",
     "head": {"gas_used": 30000000},
     "state": {"alice": {"balance": 100000000}},
     "steps": [{"build": {"skip": ["alice"], "ils": [[{"label": "low", "sender": "alice", "max_fee": 10, "tip": 1}]]}, "expect": [], "expect_omission": null}]},
    {"name": "under eip-7805 a valid frame transaction is never the omission",
     "focil": "eip-7805",
     "state": {"alice": {"balance": 100000000}},
     "steps": [{"build": {"skip": ["alice"], "ils": [[{"label": "f", "type": 6, "sender": "alice", "frames": [{"mode": 1, "flags": 3, "exec_gas": 20000}, {"mode": 2, "exec_gas": 50000}]}]]}, "expect": [], "expect_omission": null}]},
    {"name": "under eip-8369 a frame transaction whose keyed nonce is already used is not valid",
     "focil": "eip-8369",
     "state": {"alice": {"balance": 100000000, "nonce_seqs": {"7": 1}}},
     "steps": [{"build": {"skip": ["alice"], "ils": [[{"label": "spent", "type": 6, "sender": "alice", "nonce_keys": [7], "frames": [{"mode": 1, "flags": 3, "exec_gas": 20000}, {"mode": 2, "exec_gas": 50000}]}]]}, "expect": [], "expect_omission": null}]},
    {"name": "under eip-8369 the same transaction on a fresh key is",
     "focil": "eip-8369",
     "state": {"alice": {"balance": 100000000}},
     "steps": [{"build": {"skip": ["alice"], "ils": [[{"label": "fresh", "type": 6, "sender": "alice", "nonce_keys": [7], "frames": [{"mode": 1, "flags": 3, "exec_gas": 20000}, {"mode": 2, "exec_gas": 50000}]}]]}, "expect": [], "expect_omission": "fresh"}]}
  ]
}
