{
  "clause": "FEE-4",
  "also": ["MD-6"],
  "document": "00-model.md",
  "version": 11,
  "operation": "frame_gas",
  "distinguishes": "Zero calldata bytes cost one token rather than four in the intrinsic gas and four in the floor: an implementation that prices every byte as non-zero, or that discounts zero bytes in the floor too, gets the max gas and max cost of a real transaction wrong.",
  "cases": [
    {
      "name": "the simple transaction of fee-4-frame-gas with 40 of its 168 bytes zero",
      "tx": {"type": 6, "sender": "alice", "zero_bytes": 40, "frames": [{"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 2, "exec_gas": 50000, "data_size": 100}]},
      "expect": {"intrinsic": 17958, "floor": 26502, "max_gas": 97958, "max_cost": 9795800},
      "derivation": "D = 100 + 65 + 3 = 168, Z = 40. intrinsic = 12000 + 2*475 + 16*168 - 12*40 + 2800 = 18438 - 480 = 17958. standard = 17958 + 30000 + 50000 = 97958. floor = 12000 + 950 + 2800 + 64*168 = 26502, as with no zero bytes. max_gas = max(97958, 26502) = 97958; max_cost = 97958 * 100."
    },
    {
      "name": "a transaction of mostly zero data, where the floor binds and is not discounted",
      "tx": {"type": 6, "sender": "alice", "zero_bytes": 1000, "frames": [{"mode": 1, "flags": 3, "exec_gas": 1000}, {"mode": 2, "data_size": 1000}]},
      "expect": {"intrinsic": 20838, "floor": 84102, "max_gas": 84102, "max_cost": 8410200},
      "derivation": "D = 1000 + 65 + 3 = 1068, Z = 1000. intrinsic = 12000 + 950 + 2800 + 16*1068 - 12*1000 = 15750 + 17088 - 12000 = 20838. standard = 20838 + 1000 = 21838. floor = 15750 + 64*1068 = 84102. max_gas = max(21838, 84102 + 0) = 84102; max_cost = 84102 * 100."
    },
    {
      "name": "zero_bytes 0 is version 8's transaction and gas",
      "tx": {"type": 6, "sender": "alice", "zero_bytes": 0, "frames": [{"mode": 1, "flags": 3, "exec_gas": 30000}, {"mode": 2, "exec_gas": 50000, "data_size": 100}]},
      "expect": {"intrinsic": 18438, "floor": 26502, "max_gas": 98438, "max_cost": 9843800},
      "derivation": "As the first case of fee-4-frame-gas: 16*168 with nothing subtracted."
    }
  ]
}
