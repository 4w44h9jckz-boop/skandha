       {
        "label": "A",
        "type": 6,
        "sender": "alice",
        "frames": [
         {
          "mode": 3,
          "deps": [
           [
            17,
            "pub-a",
            "vk-1"
           ]
          ],
          "exec_gas": 30000,
          "data_size": 96
         },
         {
          "mode": 1,
          "flags": 3
         }
        ],
        "claim": {
         "sender": "alice",
         "nonce_seq": 0,
         "epoch": 2,
         "salt": "t1",
         "binder": "b1"
        }
       }
      ]
     },
     "expect": [
      "ok"
     ]
    },
    {
     "expect_pool": {
      "pending": {
       "alice": [
        "A"
       ]
      }
     }
    }
   ],
   "derivation": "bound is true by default (MD-6), and the claim is for its own slot in the head's epoch (CG-2)."
