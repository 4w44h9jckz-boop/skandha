{
 "clause": "CG-7",
 "document": "10-claim-gated-admission.md",
 "version": 2,
 "also": [
  "CG-3",
  "CG-4",
  "CG-5",
  "AG-6",
  "AG-7"
 ],
 "operation": "pool",
 "distinguishes": "A relay runs CG-3 and then passes a mode 0 wrapper on without verifying its proofs, so a junk proof is admitted where a verifier refuses it; it refuses every mode 1 wrapper, keeps no CG-4 record, makes CG-5's, admits a transaction alone whose triples it has relayed, and builds no aggregate.",
 "cases": [
  {
   "name": "a junk proof is passed on",
   "profile": "claim-gated",
   "state": {
    "alice": {
     "balance": 1000000000
    },
    "bob": {
     "balance": 1000000000
    }
   },
   "steps": [
    {
     "wrapper": {
      "mode": 0,
      "txs": [
       {
        "label": "A",
        "type": 6,
        "sender": "alice",
        "frames": [
         {
          "mode": 3,
          "deps": [
           [
            17,
            "pub-a",
            "vk-1"
           ]
          ],
          "exec_gas": 30000,
          "data_size": 96
         },
         {
          "mode": 1,
          "flags": 3
         }
        ],
        "claim": {
         "sender": "alice",
         "nonce_seq": 0,
         "epoch": 2,
         "salt": "t1"
        }
       }
      ],
      "proofs": [
       false
      ]
     },
     "expect": [
      "ok"
     ]
    },
    {
     "expect_pool": {
      "pending": {
       "alice": [
        "A"
       ]
      }
     }
    }
   ],
   "config": {
    "frame": {
     "verifies": false
    }
   }
  },
